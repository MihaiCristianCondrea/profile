{
  "name": "profile",
  "version": "1.0.0",
  "description": "This repository contains the source for a personal profile site built as a small Single Page Application (SPA). The site presents information about Mihai-Cristian Condrea and includes additional pages such as a privacy policy and code of conduct. It is designed as a Progressive Web App using Material Web Components and TypeScript.",
  "scripts": {
    "test": "jest",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json",
    "prepare:blog": "node scripts/fetch-blog-posts.mjs",
    "verify:html-structure": "node scripts/verify-html-structure.mjs",
    "verify:source-quality": "node scripts/verify-source-quality.mjs",
    "verify:ui-policy": "node scripts/verify-ui-policy.mjs",
    "verify:svg-assets": "node scripts/verify-svg-assets.mjs",
    "verify:security": "npm audit --audit-level=moderate --omit=dev",
    "build": "npm run verify:html-structure && npm run verify:source-quality && npm run verify:ui-policy && npm run verify:svg-assets && npm run clean && npm run typecheck && npm run build:vite && npm run build:pages",
    "build:vite": "vite build",
    "build:pages": "node scripts/copy-page-fragments.mjs",
    "verify:seo": "node -e \"['dist/sitemap.xml','dist/robots.txt','dist/app-ads.txt','dist/manifest.json'].forEach((file)=>require('fs').accessSync(file));\"",
    "verify:production-assets": "node scripts/verify-production-assets.mjs",
    "deploy": "npm run build && npm run verify:seo",
    "check": "npm run verify:security && npm test -- --runInBand && npm run deploy && npm run verify:production-assets",
    "preview": "vite preview --host 127.0.0.1"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "js-yaml": "3.15.1",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "30.1.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/resources/"
    ],
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/tests/setup/structuredClone.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json",
          "diagnostics": false
        }
      ]
    }
  },
  "dependencies": {
    "@material/web": "^2.4.1"
  }
}
